            nameDisplayHTML = `<select id="mod_select_${idx}" onchange="onSelectSampleCandidate(${idx})" class="w-full text-xs font-bold p-1.5 bg-amber-50 border border-amber-300 rounded focus:ring-2 focus:ring-amber-500">
