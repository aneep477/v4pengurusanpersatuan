            const isHigh = s.markahPct >= 90;
            const catText = isHigh ? 'Amat Cemerlang (≥90%)' : 'Gagal (<50%)';
            const catBadge = isHigh ? 'bg-amber-100 text-amber-900 border-amber-300' : 'bg-red-100 text-red-900 border-red-300';
            return `<tr>
                <td><span class="px-2 py-1 rounded text-[10px] font-extrabold border ${catBadge}">${catText}</span></td>
                <td class="font-bold">${s.nama}</td>
