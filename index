function onSelectSampleCandidate(idx) {
    const sel = document.getElementById(`mod_select_${idx}`);
    if (!sel || !window_modSamplesData[idx]) return;

    const selectedKP = sel.value;
    const item = window_modSamplesData[idx];
    const opts = item.allOptions || [];
    const chosen = opts.find(o => o.kp === selectedKP);

    if (chosen) {
        item.kp = chosen.kp;
        item.nama = chosen.nama;
        item.kelas = chosen.kelas;
        item.markah = chosen.markah;
        item.markahPct = chosen.markahPct;
        item.maxPossible = chosen.maxPossible;
        item.gred = chosen.gred;
        item.kelompok = chosen.kelompok || "Kelompok Sederhana";

        document.getElementById(`mod_kp_${idx}`).textContent = chosen.kp;
        document.getElementById(`mod_kelas_${idx}`).textContent = chosen.kelas;
        document.getElementById(`mod_score_${idx}`).textContent = `${chosen.markah} / ${chosen.maxPossible} (${chosen.markahPct.toFixed(1)}%)`;
        document.getElementById(`mod_gred_${idx}`).textContent = chosen.gred;
        
        const bandCat = item.kelompok;
        const kelBg = bandCat.includes('Tinggi') 
            ? 'bg-indigo-100 text-indigo-900 border-indigo-300 font-black' 
            : bandCat.includes('Sederhana') 
            ? 'bg-amber-100 text-amber-900 border-amber-300 font-black' 
            : 'bg-emerald-100 text-emerald-900 border-emerald-300 font-black';
        document.getElementById(`mod_kelompok_${idx}`).innerHTML = `<span class="px-2.5 py-1 rounded text-[10px] font-bold border ${kelBg}">${bandCat}</span>`;
    }
}

async function handleLockSingleSample(idx) {
    const s = window_modSamplesData[idx];
    if (!s) return;

    const taskEl = document.getElementById('moderationTaskFilter');
    const classEl = document.getElementById('moderationClassFilter');
    const task = taskEl ? taskEl.value : "all";
    const kelas = classEl ? classEl.value : "";

    showToast(`Mengunci sampel untuk ${s.penilai}...`, 'success');

    try {
        await fetch(API, {
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify({
                action: "lockSingleSample",
                task: task,
                kelasFilter: kelas,
                bil: s.bil,
                kp: s.kp,
                nama: s.nama,
                kelas: s.kelas,
                markah: s.markah,
                markahPct: s.markahPct,
                maxPossible: s.maxPossible,
                gred: s.gred,
                penilai: s.penilai,
                kelompok: s.kelompok,
                by: curLecEmail
            })
        });
        await new Promise(r => setTimeout(r, 1200));
        showToast(`Sampel ${s.nama} (${s.penilai}) KINI TERKUNCI!`, 'success');
        loadModerationSampling();
    } catch(e) { showToast('Ralat mengunci sampel.', 'warn'); }
}

async function handleUnlockSingleSample(penilai) {
    const taskEl = document.getElementById('moderationTaskFilter');
    const classEl = document.getElementById('moderationClassFilter');
    const task = taskEl ? taskEl.value : "all";
    const kelas = classEl ? classEl.value : "";

    showToast(`Membuka kunci sampel ${penilai}...`, 'warn');

    try {
        await fetch(API, {
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify({
                action: "unlockSingleSample",
                task: task,
                kelasFilter: kelas,
                penilai: penilai
            })
        });
        await new Promise(r => setTimeout(r, 1200));
        showToast(`Kunci sampel ${penilai} telah dibuka.`, 'success');
        loadModerationSampling();
    } catch(e) { showToast('Ralat membuka kunci.', 'warn'); }
}

