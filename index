    document.getElementById('sList').innerHTML = filtered.map(s => {
        const hM = s.markahSediaAda, hP = s.peerSummary && s.peerSummary.count>0;
        return `<div class="s-card ${hM?'done':''}" data-kp="${s.No_KP}" onclick="selectStudent('${s.No_KP}')"><div style="display:flex; align-items:center; gap:12px;"><div class="eval-dot ${hM?'done':'pending'}"></div><div style="flex:1; min-width:0;"><div style="font-size:12px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${s.Nama_Pelajar}</div><div class="font-mono-score" style="font-size:10px; color:var(--text-muted); margin-top:2px;">${s.Kelas} · ${s.No_KP}</div></div>${hP?`<span class="bg-blue-50 text-blue-700 border border-blue-200" style="font-size:10px; padding:2px 6px; border-radius:4px; font-weight:700;"><i class="fas fa-users mr-1"></i>${s.peerSummary.count}</span>`:''}</div></div>`;
