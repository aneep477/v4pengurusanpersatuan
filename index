                    <span id="tot_${cat.id}" class="font-mono-score text-3xl font-black" style="color:${cat.color}; line-height:1;">0</span>
                    <span class="text-sm font-bold text-slate-400 mb-1">/ ${cat.max}</span>
                </div>
            </div>
