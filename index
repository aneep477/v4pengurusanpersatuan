        }).join('');
        return `<div class="academic-card mb-8 overflow-hidden shadow-md">
            <div class="p-4 border-b flex justify-between items-center" style="background:${cat.bg};">
                <div class="text-sm font-bold uppercase tracking-wider flex items-center gap-2" style="color:${cat.color};"><i class="fas ${cat.icon}"></i> ${cat.title}</div>
            </div>
            <div class="p-5 bg-slate-50 border-b">${inputs}</div>
            <div class="p-5 flex justify-between items-center bg-white">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Jumlah Sub-Markah Kategori Ini</span>
