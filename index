function normalizeKP(kp) {
    if (!kp) return "";
    let clean = kp.toString().trim().replace(/['"\s]/g, '');
    if (/^\d+$/.test(clean) && clean.length < 12) {
        clean = clean.padStart(12, '0');
    }
    return clean;
}

function fixDriveUrl(url) { 
    if (!url) return ""; 
    let id = url.match(/\/d\/([a-zA-Z0-9_-]+)/)?.[1] || url.match(/[?&]id=([a-zA-Z0-9_-]+)/)?.[1]; 
    return id ? `https://lh3.googleusercontent.com/d/${id}` : url; 
}

function loadImage(iEl, pEl, url) { 
    if (!url) { if(iEl) iEl.style.display='none'; if(pEl) pEl.style.display='flex'; return; } 
    if(iEl) {
        iEl.onload = () => { iEl.style.display='block'; if(pEl) pEl.style.display='none'; }; 
        iEl.onerror = () => { iEl.style.display='none'; if(pEl) pEl.style.display='flex'; }; 
        iEl.src = fixDriveUrl(url); 
    }
}

