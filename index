function showToast(msg, type='success') { 
    const t = document.getElementById('toast'), m = document.getElementById('toastMsg'); 
    if(!t || !m) return;
    const icon = type === 'success' ? 'fa-check-circle text-green-600' : 'fa-exclamation-triangle text-amber-600'; 
    const bColor = type === 'success' ? 'var(--hp8-color)' : 'var(--hp10-color)'; 
    t.style.borderLeftColor = bColor; 
    m.innerHTML = `<i class="fas ${icon} text-lg"></i><span class="text-slate-700">${msg}</span>`; 
    t.classList.add('show'); 
    setTimeout(() => t.classList.remove('show'), 3000); 
}

function calculateGred(m) { if (m>=90) return "A+"; if (m>=80) return "A"; if (m>=75) return "A-"; if (m>=70) return "B+"; if (m>=65) return "B"; if (m>=60) return "B-"; if (m>=55) return "C+"; if (m>=50) return "C"; if (m>=40) return "C-"; if (m>=30) return "D+"; if (m>=20) return "D"; return "F"; }

