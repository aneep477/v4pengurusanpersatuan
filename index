function buildRC(dims) {
    return { 
        type:'radar', 
        data:{ 
            labels:DIMS, 
            datasets:[{ 
                data:dims, 
                backgroundColor:'rgba(59, 130, 246, 0.1)', 
                borderColor:'#2563eb', 
                borderWidth: 2, 
                pointBackgroundColor: DIM_COLORS, 
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7
            }] 
        }, 
        options:{ 
            responsive:true, maintainAspectRatio:false, 
            plugins:{legend:{display:false}}, 
            scales:{ 
                r:{ 
                    min:0, max:5, 
                    ticks:{stepSize:1, display:true, backdropColor:'transparent', color:'#94a3b8', font:{size:9, family:'Space Mono'}}, 
                    grid:{color:'#e2e8f0'}, 
                    angleLines:{color:'#e2e8f0'},
                    pointLabels:{color:'#475569', font:{size:11, weight:'bold', family:'Plus Jakarta Sans'}} 
                } 
            } 
        } 
    };
}

function calc() {
    const v=['h1','h5','h8','h10'].map(id=>Math.max(0,Number(document.getElementById(id).value)||0)); const t=v.reduce((a,b)=>a+b,0);
    document.getElementById('tm').textContent=t; const g=calculateGred(t); document.getElementById('gd').textContent=g;
    document.getElementById('justArea').style.display=g==='A+'?'block':'none';
    
    document.getElementById('tm').style.color = t >= 80 ? '#0284c7' : t >= 50 ? '#d97706' : '#dc2626';
    document.getElementById('gd').style.color = g.includes('A') ? '#16a34a' : g.includes('B') ? '#2563eb' : g.includes('C') ? '#d97706' : '#dc2626';
}

function renderSummaryTable() {
