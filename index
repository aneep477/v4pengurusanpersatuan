        else { showToast('Transmisi berjaya. Muat semula untuk pengesahan.', 'warn'); await _refreshLecData(); }
    } catch(e) { showToast('Ralat transmisi data.', 'err'); }
    btn.disabled=false; btn.innerHTML='<i class="fas fa-save me-2 text-lg"></i> SIMPAN SEMUA KEPUTUSAN RUBRIK';
}

