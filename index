function filterStudents(query) {
    const q = query.toLowerCase();
    const classSel = document.getElementById('classFilter');
    const selectedClass = classSel ? classSel.value : "";
    const filtered = sData.filter(s => {
        const matchQ = s.Nama_Pelajar.toLowerCase().includes(q) || s.No_KP.includes(q);
        const matchClass = !selectedClass || (s.Kelas && s.Kelas.toString() === selectedClass);
