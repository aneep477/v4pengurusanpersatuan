    if (!filteredData.length) { 
        tbody.innerHTML = '<tr><td colspan="9" class="text-center p-8 text-slate-400">Tiada rekod pelajar bagi kelas ini.</td></tr>'; 
        return; 
    }

    tbody.innerHTML = filteredData.map((s, index)=>{
        const m=s.markahSediaAda||{}, t=(m.hp1||0)+(m.hp5||0)+(m.hp8||0)+(m.hp10||0), g=t>0?calculateGred(t):'--';
        const isOdd = index % 2 !== 0;
        const bg = isOdd ? 'bg-slate-50' : 'bg-white';
        const gBadge = g.includes('A') ? 'bg-green-100 text-green-800' : g.includes('B') ? 'bg-blue-100 text-blue-800' : g.includes('C') ? 'bg-amber-100 text-amber-800' : g==='--' ? 'bg-slate-100 text-slate-500' : 'bg-red-100 text-red-800';
        
        return `<tr class="${bg} border-b border-slate-200 hover:bg-blue-50 transition-colors">
            <td class="p-3">
                <div class="font-bold text-[13px] text-slate-800">${s.Nama_Pelajar}</div>
                <div class="font-mono-score text-[10px] text-slate-500 mt-1">${s.No_KP} <span class="mx-1">•</span> ${s.Kelas}</div>
            </td>
            <td class="p-3 text-center font-mono-score text-[13px] font-bold" style="color:var(--hp1-color);">${m.hp1 ?? '-'}</td>
            <td class="p-3 text-center font-mono-score text-[13px] font-bold" style="color:var(--hp5-color);">${m.hp5 ?? '-'}</td>
            <td class="p-3 text-center font-mono-score text-[13px] font-bold" style="color:var(--hp8-color);">${m.hp8 ?? '-'}</td>
            <td class="p-3 text-center font-mono-score text-[13px] font-bold" style="color:var(--hp10-color);">${m.hp10 ?? '-'}</td>
            <td class="p-3 text-center font-mono-score text-[15px] font-black text-slate-800 bg-slate-100 border-l border-r">${t || '-'}</td>
            <td class="p-3 text-center">
                <span class="inline-block px-2 py-1 rounded font-serif-title font-bold text-sm ${gBadge}">${g}</span>
            </td>
            <td class="p-3 text-center">
                ${s.peerSummary ? `<span class="bg-blue-50 text-blue-600 border border-blue-200 px-2 py-1 rounded font-mono-score text-[11px] font-bold">${s.peerSummary.avg.toFixed(1)}/5</span>` : '<span class="text-slate-300 text-xs">-</span>'}
            </td>
            <td class="p-3 text-center">
                <button onclick="printIndividualReport('${s.No_KP}')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border transition" title="Cetak Laporan Individu">
                    <i class="fas fa-file-pdf text-indigo-700 mr-1"></i> Dossier
                </button>
            </td>
        </tr>`;
    }).join('');
}

