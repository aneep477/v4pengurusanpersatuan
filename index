async function saveRubrik() {
    if(!curS) return; const btn=document.getElementById('saveRubrikBtn'); btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Memproses dan Menyimpan...';
    const pl = { action:"submitRubrik", noKP:curS.No_KP.toString(), nama:curS.Nama_Pelajar, kelas:curS.Kelas, penilai:curLecEmail, data:{} };
    RUBRIK_CONFIG.forEach(cat => cat.items.forEach((it,idx) => pl.data[cat.prefix+(idx+1)] = parseFloat(document.getElementById('rub_'+cat.prefix+(idx+1))?.value)||0 ));
    try {
        await fetch(API, { method:'POST', mode:'no-cors', body:JSON.stringify(pl) });
        let vD=null; for(let i=1; i<=5; i++) {
            await new Promise(r=>setTimeout(r,1500));
            try { const vR = await fetch(`${API}?action=getRubrikStatus&noKP=${encodeURIComponent(curS.No_KP)}`); const vO = await vR.json(); if(vO.ada) { vD=vO.data; break; } } catch(e){}
        }
