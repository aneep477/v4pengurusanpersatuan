<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal MPU3221 | Sistem Penilaian & Moderasi IPGKDA</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #0f172a;       
            --primary-accent: #1e3a8a;
            --secondary: #9f1239;     
            --gold-accent: #d97706;   
            
            --hp1-color: #4338ca;  
            --hp5-color: #0369a1;  
            --hp8-color: #15803d;  
            --hp10-color: #b45309; 
            
            --bg-body: #f8fafc;    
            --bg-surface: #ffffff; 
            --bg-alt: #f1f5f9;     
            
            --text-main: #0f172a;  
            --text-muted: #64748b; 
            --border: #e2e8f0;     
            --shadow-sm: 0 1px 3px 0 rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -1px rgba(15, 23, 42, 0.04);
            --shadow-lg: 0 10px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg-body); min-height: 100vh; color: var(--text-main); }
        .font-serif-title { font-family: 'Lora', serif; }
        .font-mono-score { font-family: 'Space Mono', monospace; }
        
        .shell { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1.5rem; }
        .academic-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 0.85rem; box-shadow: var(--shadow-sm); transition: all 0.2s ease-in-out; }
        
        .btn-primary { background: var(--primary-accent); border: 1px solid var(--primary-accent); cursor: pointer; transition: all 0.2s ease-in-out; color: white; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; box-shadow: var(--shadow-sm); }
        .btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); box-shadow: var(--shadow-md); }
        .btn-primary:disabled { background: #94a3b8; border-color: #94a3b8; cursor: not-allowed; transform: none; box-shadow: none; }
        
        .btn-outline { background: transparent; border: 1px solid var(--border); cursor: pointer; transition: all 0.2s; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 11px; }
        .btn-outline:hover { border-color: var(--primary-accent); color: var(--primary-accent); background: #f8fafc; }

        .tab-bar { display: flex; gap: 6px; background: var(--bg-alt); padding: 5px; border-radius: 0.75rem; border: 1px solid var(--border); }
        .tab { flex: 1; padding: 10px 14px; border-radius: 0.5rem; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: all 0.2s; background: transparent; border: none; color: var(--text-muted); }
        .tab.active { background: var(--bg-surface); color: var(--primary-accent); box-shadow: var(--shadow-sm); border: 1px solid var(--border); }

        .likert-group { display: flex; gap: 6px; }
        .likert-btn { flex: 1; padding: 12px 4px; border-radius: 0.5rem; border: 1px solid var(--border); background: var(--bg-surface); cursor: pointer; font-size: 12px; font-weight: 700; color: var(--text-muted); transition: all 0.2s; text-align: center; }
        .likert-btn:hover { border-color: var(--primary-accent); color: var(--primary-accent); background: #eff6ff; }
        .likert-btn.sel-1 { background: #fef2f2; border-color: #ef4444; color: #b91c1c; }
        .likert-btn.sel-2 { background: #fffbeb; border-color: #f59e0b; color: #b45309; }
        .likert-btn.sel-3 { background: #fefce8; border-color: #eab308; color: #a16207; }
        .likert-btn.sel-4 { background: #f0fdf4; border-color: #10b981; color: #15803d; }
        .likert-btn.sel-5 { background: #eff6ff; border-color: #3b82f6; color: #1d4ed8; }

        .s-card { padding: 14px 16px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 0.75rem; margin-bottom: 8px; cursor: pointer; transition: all 0.2s; border-left: 4px solid transparent; }
        .s-card:hover { background: var(--bg-alt); border-left-color: #94a3b8; }
        .s-card.selected { background: #eff6ff; border-left-color: var(--primary-accent); border-color: #bfdbfe; }
        .s-card.done { border-left-color: var(--hp8-color); }

        .scroll-thin::-webkit-scrollbar { width: 6px; height: 6px; }
        .scroll-thin::-webkit-scrollbar-track { background: var(--bg-alt); border-radius: 10px; }
        .scroll-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .scroll-thin::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        input[type=number], input[type=text], input[type=password], textarea, select { background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-main); outline: none; transition: all 0.2s; border-radius: 0.5rem; padding: 0.75rem 1rem; }
        input:focus, textarea:focus, select:focus { border-color: var(--primary-accent); box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.12); }
        input:disabled { background: var(--bg-alt); color: var(--text-muted); cursor: not-allowed; }

        .alert-info { padding: 14px 18px; border-radius: 0.6rem; font-size: 13px; font-weight: 600; display: flex; align-items: flex-start; gap: 12px; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; }
        .alert-warn { padding: 14px 18px; border-radius: 0.6rem; font-size: 13px; font-weight: 600; display: flex; align-items: flex-start; gap: 12px; background: #fffbeb; border: 1px solid #fde68a; color: #b45309; }

        #toast { position: fixed; top: 24px; right: 24px; z-index: 9999; transform: translateX(140%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        #toast.show { transform: translateX(0); }

        .spinner { width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.6s linear infinite; display: inline-block; vertical-align: middle; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .eval-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.1); }
        .eval-dot.done { background: var(--hp8-color); }
        .eval-dot.pending { background: #cbd5e1; }

        .q-block { padding: 20px; border-radius: 0.75rem; background: var(--bg-surface); border: 1px solid var(--border); margin-bottom: 16px; box-shadow: var(--shadow-sm); }
        .dim-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 6px; display: block; }

        .disclaimer-bar { background: #0f172a; border-bottom: 2px solid var(--gold-accent); padding: 10px 24px; display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 11px; color: #f8fafc; letter-spacing: 0.02em; text-align: center; flex-wrap: wrap; position: sticky; top: 0; z-index: 100; }
        .disclaimer-bar strong { color: #facc15; font-weight: 700; }
        .disclaimer-bar .sep { opacity: 0.3; margin: 0 4px; }

        .disclaimer-footer { background: #f1f5f9; border-top: 1px solid var(--border); padding: 24px; text-align: center; font-size: 11px; color: var(--text-muted); line-height: 1.8; margin-top: auto; }

        .academic-table { width: 100%; border-collapse: collapse; font-size: 12.5px; background: var(--bg-surface); }
        .academic-table th { background: var(--bg-alt); padding: 12px; text-align: left; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom: 2px solid var(--border); border-top: 1px solid var(--border); }
        .academic-table td { padding: 12px; border-bottom: 1px solid var(--border); vertical-align: middle; color: var(--text-main); }
        .academic-table tr:last-child td { border-bottom: none; }
        .academic-table tbody tr:hover { background: #f8fafc; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn 0.3s ease forwards; }

        #printArea, #printModerationArea, #printIndividualArea { display: none; }
        .print-table { width: 100%; border-collapse: collapse; font-size: 10px; }
        .print-table th, .print-table td { border: 1px solid #94a3b8; padding: 5px 6px; text-align: left; }
        .print-table th { background: #f1f5f9; font-weight: 800; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.03em; color: #1e293b; }
        .print-table td.center, .print-table th.center { text-align: center; }
        .print-header { text-align: center; border-bottom: 3px double #0f172a; padding-bottom: 8px; margin-bottom: 12px; }
        .print-header h1 { font-family: 'Lora', serif; font-size: 17px; font-weight: 700; margin: 2px 0; color: #0f172a; }
        .print-header h2 { font-size: 10.5px; font-weight: 600; color: #334155; margin: 0; }
        .print-meta { display: flex; justify-content: space-between; font-size: 9.5px; margin-bottom: 10px; padding: 4px 0; border-bottom: 1px solid #cbd5e1; }
        .print-section-title { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin: 12px 0 6px; border-left: 4px solid #1e3a8a; padding-left: 6px; color: #1e3a8a; }
        
        .dossier-page { page-break-after: always; break-after: page; padding: 4px; }
        .dossier-page:last-child { page-break-after: avoid; break-after: avoid; }

        @media print {
            @page { size: A4 portrait; margin: 8mm; }
            body.printing-mode > *:not(#printArea):not(#printModerationArea):not(#printIndividualArea) { display: none !important; }
            body.printing-mode #printArea.active-print { display: block !important; }
            body.printing-mode #printModerationArea.active-print { display: block !important; }
            body.printing-mode #printIndividualArea.active-print { display: block !important; }
            body.printing-mode { background: white !important; }
        }
    </style>
</head>
<body>

<!-- BAR NOTIS KESELAMATAN & STATUS SULIT -->
<div class="disclaimer-bar" id="globalDisclaimer">
    <i class="fas fa-shield-alt" style="color:#facc15; font-size:14px;"></i>
    <span style="flex:1;">
        <strong>SISTEM MAKLUMAT SULIT & TERHAD</strong>
        <span class="sep">|</span> Kegunaan Rasmi <strong>Unit Kokurikulum IPGKDA</strong>
        <span class="sep">|</span> Kod Kursus: <strong>MPU3221 (Pengurusan Persatuan)</strong>
    </span>
    <button onclick="document.getElementById('globalDisclaimer').style.display='none'" style="background:none; border:none; color:white; cursor:pointer; font-size:16px; padding:0 4px;"><i class="fas fa-times"></i></button>
</div>

<!-- CONTAINER TOAST NOTIFICATION -->
<div id="toast">
    <div class="academic-card px-5 py-4 flex items-center gap-3 text-sm font-bold shadow-lg" id="toastMsg" style="border-left: 4px solid var(--hp8-color);"></div>
</div>

<!-- SKRIN LOG MASUK UTAMA -->
<div class="shell" id="loginScreen">
    <div class="academic-card w-full shadow-2xl p-8 sm:p-10 border-t-4" style="max-width:440px; border-top-color: var(--primary-accent);">
        <div class="text-center mb-8">
            <div style="display:inline-flex; align-items:center; justify-content:center; width:90px; height:90px; margin-bottom:12px;">
                <img src="https://lh3.googleusercontent.com/d/10kap54x0sqPu4bFZdju9P2fXKMpyMVi8" referrerpolicy="no-referrer" crossorigin="anonymous" alt="Logo IPGKDA" style="max-width:100%; max-height:100%; object-fit:contain;" onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\\'fas fa-university\\' style=\\'font-size:2.5rem; color:var(--primary-accent);\\'></i>';">
            </div>
            
            <div style="font-size:10px; font-weight:800; letter-spacing:0.15em; color:var(--secondary); text-transform:uppercase; margin-bottom:8px;">
                Institut Pendidikan Guru<br>Kampus Darulaman
            </div>
            
            <h1 class="font-serif-title" style="font-size:1.75rem; font-weight:700; color:var(--text-main); line-height:1.2; margin-bottom:4px;">
                Portal Pemarkahan
            </h1>
            
            <p style="font-size:13px; color:var(--text-muted); font-weight:500;">
                MPU3221 — Pengurusan Persatuan
            </p>
        </div>

        <div class="tab-bar mb-6">
            <button class="tab active" id="ts" onclick="setType('student')"><i class="fas fa-user-graduate me-1"></i> Ruang Pelajar</button>
            <button class="tab" id="tl" onclick="setType('lecturer')"><i class="fas fa-chalkboard-teacher me-1"></i> Ruang Pensyarah</button>
        </div>

        <div class="flex flex-col gap-4 mb-6">
            <div>
                <label class="dim-label">Kredensial Log Masuk</label>
                <input type="text" id="idIn" placeholder="No. Kad Pengenalan / Emel Rasmi" class="w-full font-mono-score text-center">
            </div>
            <div id="pwField" class="hidden">
                <input type="password" id="pwIn" placeholder="Kata Laluan Pensyarah" class="w-full text-center">
            </div>
        </div>

        <button onclick="handleAuth()" id="loginBtn" class="btn-primary w-full rounded-lg p-4 text-sm mt-2">
            <i class="fas fa-sign-in-alt me-2"></i> Akses Sistem
        </button>
    </div>
</div>

<!-- DASHBOARD PELAJAR -->
<div id="studentDash" style="display:none; min-height:100vh; flex-direction:column;">
    <div style="background:var(--bg-surface); border-bottom:1px solid var(--border); padding:16px 32px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:50; box-shadow:var(--shadow-sm);">
        <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:40px; height:40px; background:var(--bg-alt); border: 1px solid var(--border); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:16px; color:var(--primary-accent);">
                <i class="fas fa-user-graduate"></i>
            </div>
            <div>
                <div style="font-size:10px; font-weight:800; letter-spacing:0.1em; color:var(--text-muted); text-transform:uppercase;">Dossier Pelajar</div>
                <div id="hdrName" class="font-serif-title" style="font-size:16px; font-weight:700; color:var(--text-main);">--</div>
            </div>
        </div>
        <button onclick="logout()" class="btn-outline px-4 py-2 rounded-lg"><i class="fas fa-sign-out-alt me-1"></i> Log Keluar</button>
    </div>

    <div style="padding:24px 32px 0;">
        <div class="tab-bar" style="max-width:400px;">
            <button class="tab active" onclick="showStudentTab('profile')"><i class="fas fa-id-badge me-1"></i> Profil Pengguna</button>
            <button class="tab" onclick="showStudentTab('peer')"><i class="fas fa-users me-1"></i> Penilaian Rakan</button>
        </div>
    </div>

    <div id="stab-profile" style="padding:24px 32px; flex:1; display:flex; flex-wrap:wrap; gap:24px;">
        <div class="academic-card p-8 flex-1 min-w-[300px]">
            <div style="font-size:11px; font-weight:800; letter-spacing:0.1em; color:var(--primary-accent); text-transform:uppercase; margin-bottom:24px; border-bottom:2px solid var(--bg-alt); padding-bottom:12px;">Maklumat Pendaftaran Rasmi</div>
            
            <div class="space-y-6">
                <div>
                    <label class="dim-label">Nama Penuh Calon</label>
                    <div id="sN" class="font-serif-title" style="font-size:20px; font-weight:700; color:var(--text-main);">--</div>
                </div>
                <div>
                    <label class="dim-label">No. Kad Pengenalan</label>
                    <div id="sK" class="font-mono-score" style="color:var(--text-muted); font-size:15px; font-weight:700; background:var(--bg-alt); padding:8px 12px; border-radius:6px; display:inline-block; border:1px solid var(--border);">--</div>
                </div>
                <div>
                    <label class="dim-label">Kumpulan / Kelas</label>
                    <div id="sC" style="font-size:16px; font-weight:700; color:var(--text-main);">--</div>
                </div>
                <div>
                    <label class="dim-label">Status Dokumen Gambar</label>
                    <div id="sS" style="display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:700; background:#fefce8; color:#a16207; border:1px solid #fde047;">
                        <i class="fas fa-clock"></i> Menunggu Muat Naik
                    </div>
                </div>
            </div>
        </div>
        
        <div class="flex-1 min-w-[300px] flex flex-col gap-4">
            <div class="academic-card p-6">
                <div class="dim-label mb-4">Gambar Profil (Format Pasport)</div>
                <div id="imgBox" style="width:100%; aspect-ratio:3/4; max-width:200px; margin:0 auto; border-radius:0.5rem; overflow:hidden; background:var(--bg-alt); border:2px dashed var(--border); display:flex; align-items:center; justify-content:center; position:relative;">
                    <img id="sImg" style="width:100%; height:100%; object-fit:cover; display:none;" alt="Gambar Pelajar">
                    <div id="sPl" style="display:flex; flex-direction:column; align-items:center; gap:12px; color:var(--text-muted);">
                        <i class="fas fa-camera" style="font-size:2.5rem; opacity:0.5;"></i>
                        <span style="font-size:11px; font-weight:600; text-transform:uppercase;">Tiada Imej</span>
                    </div>
                </div>
                
                <div style="display:grid; grid-template-columns:1fr; gap:10px; margin-top:20px; max-width:200px; margin-left:auto; margin-right:auto;">
                    <button onclick="document.getElementById('fIn').click()" class="btn-outline py-3 px-4 rounded-lg"><i class="fas fa-folder-open me-2"></i> Pilih Fail</button>
                    <button onclick="hUp()" id="uploadBtn" class="btn-primary py-3 px-4 rounded-lg"><i class="fas fa-upload me-2"></i> Muat Naik</button>
                </div>
                <input type="file" id="fIn" hidden accept="image/*" onchange="pImg(this)">
                
                <p style="font-size:10px; color:var(--text-muted); text-align:center; margin-top:12px; line-height:1.5;">*Sila muat naik gambar berukuran pasport yang jelas dan sopan untuk rekod rasmi pemarkahan.</p>
            </div>
        </div>
    </div>

    <div id="stab-peer" style="padding:24px 32px; flex:1; display:none;">
        <div class="alert-info mb-6 shadow-sm">
            <i class="fas fa-info-circle text-lg mt-1"></i>
            <div>
                <strong style="display:block; margin-bottom:4px; font-size:14px;">Arahan Penilaian Rakan Sebaya (HP8)</strong>
                Sila berikan penilaian yang jujur, objektif dan profesional terhadap semua rakan kumpulan/kelas anda. Data ini adalah sulit dan nama penilai tidak akan didedahkan kepada pelajar yang dinilai.
            </div>
        </div>
        
        <div style="display:grid; grid-template-columns:320px 1fr; gap:24px;">
            <div class="academic-card p-5" style="align-self: start; position: sticky; top: 100px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid var(--border); padding-bottom:12px;">
                    <span style="font-size:11px; font-weight:800; color:var(--text-main); text-transform:uppercase; letter-spacing:0.05em;">Daftar Rakan</span>
                    <span id="evalProgress" class="font-mono-score font-bold text-xs" style="color:var(--hp8-color); background:#f0fdf4; padding:4px 10px; border-radius:20px; border:1px solid #bbf7d0;">0/0</span>
                </div>
                <div id="peerList" class="scroll-thin" style="max-height:calc(100vh - 280px); overflow-y:auto; padding-right:8px;"></div>
            </div>
            
            <div id="peerPanel" style="display:none;" class="fade-in">
                <div class="academic-card p-8">
                    <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px; padding-bottom:20px; border-bottom:2px solid var(--bg-alt);">
                        <div id="peerImgPh" style="width:60px; height:60px; border-radius:50%; border:2px solid var(--border); background:var(--bg-alt); display:flex; align-items:center; justify-content:center; overflow:hidden;">
                            <i class="fas fa-user text-2xl text-slate-400"></i>
                            <img id="peerImg" style="width:100%; height:100%; object-fit:cover; display:none;" alt="">
                        </div>
                        <div>
                            <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.05em; margin-bottom:2px;">Penilaian Borang HP8 Untuk:</div>
                            <div id="peerName" class="font-serif-title" style="font-size:22px; font-weight:700; color:var(--primary-accent);">--</div>
                            <div id="peerKlass" class="font-mono-score" style="font-size:12px; color:var(--text-muted); margin-top:4px;">--</div>
                        </div>
                        <div id="peerDoneTag" style="margin-left:auto; display:none;">
                            <span style="background:#f0fdf4; border:1px solid #bbf7d0; color:#15803d; font-size:12px; font-weight:700; padding:8px 16px; border-radius:8px; box-shadow:var(--shadow-sm);"><i class="fas fa-check-double me-2"></i> Selesai Dinilai</span>
                        </div>
                    </div>
                    
                    <div id="peerQuestions"></div>
                    
                    <div style="margin-top:24px; border-top:1px solid var(--border); padding-top:24px;">
                        <button id="submitPeerBtn" onclick="submitPeerEval()" class="btn-primary w-full py-4 rounded-lg text-[14px]">
                            <i class="fas fa-paper-plane me-2"></i> Serahkan Penilaian
                        </button>
                    </div>
                </div>
            </div>
            
            <div id="peerPanelEmpty" class="academic-card p-12 flex items-center justify-center border-dashed border-2 bg-slate-50">
                <div style="text-align:center; color:var(--text-muted);">
                    <div style="width:80px; height:80px; background:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; box-shadow:var(--shadow-sm); border:1px solid var(--border);">
