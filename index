                return `<div class="p-4 border rounded-lg ${bg} text-center shadow-sm">
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider mb-2">Penilai ${idx+1}</div>
                    <div class="font-mono-score text-2xl font-black ${tc} leading-none mb-3">${avg}</div>
                    <div class="flex justify-center gap-1 mb-3">
                        ${[ev.q1,ev.q2,ev.q3,ev.q4,ev.q5].map((v,i)=>`<div class="w-4 h-4 rounded text-[9px] font-bold flex items-center justify-center text-white" style="background:${DIM_COLORS[i]}; opacity:${0.4 + (v/5)*0.6};" title="${DIMS[i]}: ${v}">${v}</div>`).join('')}
                    </div>
                    ${ev.note ? `<div class="text-[10px] text-slate-600 italic bg-white p-2 rounded border line-clamp-3 hover:line-clamp-none text-left leading-relaxed">"${ev.note}"</div>` : ''}
