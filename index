    const lockedCount = window_modSamplesData.filter(s => s.isLocked).length;
    document.getElementById('modSamplesCountBadge').textContent = `${lockedCount}/${window_modSamplesData.length} Sampel Terkunci`;

    document.getElementById('modSamplesBody').innerHTML = window_modSamplesData.map((s, idx) => {
