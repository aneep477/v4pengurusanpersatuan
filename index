}

function clampRubrik(k, max) { 
    const el=document.getElementById('rub_'+k); let v=parseFloat(el.value)||0; if(v>max) el.value=max; if(v<0) el.value=0; 
    const parent = el.closest('.flex.items-center');
    if(v === max && parent) { parent.style.borderLeftColor = el.style.color; parent.style.background = '#f8fafc'; } 
    else if (parent) { parent.style.borderLeftColor = '#e2e8f0'; parent.style.background = 'white'; }
}

function calcLecRubrikTotal() {
    RUBRIK_CONFIG.forEach(cat => {
        let sum = 0; cat.items.forEach((item, idx) => { sum += parseFloat(document.getElementById('rub_'+cat.prefix+(idx+1))?.value) || 0; });
        const el = document.getElementById('tot_'+cat.id); if(el) el.textContent = sum;
    });
}

