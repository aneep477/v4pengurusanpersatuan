                        <div class="h-full rounded-full transition-all duration-700" style="width:${(v/5)*100}%; background:${DIM_COLORS[i]};"></div>
                    </div>
                </div>`).join('');
            
            const oa = o.avg; let intp='';
            const maxDim = DIMS[o.avgDims.indexOf(Math.max(...o.avgDims))];
            const minDim = DIMS[o.avgDims.indexOf(Math.min(...o.avgDims))];
            if(oa>=4.5) intp=`Kredibiliti kepimpinan amat tinggi diperakui oleh rakan sebaya. Atribut kepimpinan mendatar berfokus kepada kluster <strong class="text-blue-700">${maxDim}</strong>.`;
